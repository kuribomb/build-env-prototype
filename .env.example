# =====================================================================
# ビルド環境プロトタイプ 設定ファイル
#
# setup.sh が初回実行時にこのファイルを .env としてコピーし、
# CHANGEME のパスワード類をランダム値に自動置換する。
# 手で編集するのは基本的に HOST_ADDR だけでよい。
# =====================================================================

# メンバーのPCからLAN越しにアクセスさせる場合、WindowsホストのLAN IPを設定する
# (例: HOST_ADDR=192.168.1.23)。自分のPC上だけで確認するなら localhost のまま。
# 画面やTeams通知内のリンクはこの値を使って生成される。
HOST_ADDR=localhost

# --- 公開ポート -------------------------------------------------------
PORTAL_PORT=8000
JENKINS_PORT=8080
NAS_PORT=8081
TEAMS_PORT=8082
GITLAB_PORT=8929
GITLAB_SSH_PORT=2224

# NAS相当のストレージ。Docker named volume ではなく、ホストマシンの
# ディレクトリをそのままバインドマウントする(相対パスはリポジトリ直下基準)。
# 本番のNAS共有ディレクトリを直接マウントする場合は、ここを実パスに変更する
# (例: NAS_HOST_PATH=/mnt/nas/builds)。
NAS_HOST_PATH=./nas-data

# --- コンテナイメージ(再現性のためバージョン固定) ---------------------
GITLAB_IMAGE=gitlab/gitlab-ce:19.1.3-ce.0

# --- 認証情報(CHANGEME は setup.sh が自動生成) ------------------------
GITLAB_ROOT_PASSWORD=CHANGEME
GITLAB_PAT=CHANGEME
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=CHANGEME

# jenkins-agent への SSH 公開鍵(setup.sh が secrets/agent_ssh_key.pub から転記)
AGENT_SSH_PUBKEY=
